<script>
require(['jquery', 'domReady!'], function($) {
    var styleData = {};

    function loadExisting() {
        var existing = $('[name="badge_style"]').not('#sb-style-json').val();
        if (existing && typeof existing === 'string') {
            try { styleData = JSON.parse(existing); } catch(e) { styleData = {}; }
        }
        // Populate from data
        if (styleData.borderRadius !== undefined) $('[data-prop="borderRadius"]').val(styleData.borderRadius);
        if (styleData.fontSize) {
            var fs = typeof styleData.fontSize === 'object' ? styleData.fontSize.value : styleData.fontSize;
            $('[data-prop="fontSize"]').val(fs);
        }
        if (styleData.fontWeight) $('[data-prop="fontWeight"]').val(styleData.fontWeight);
        if (styleData.opacity) $('[data-prop="opacity"]').val(styleData.opacity);
        if (styleData.boxShadow) $('[data-prop="boxShadow"]').val(styleData.boxShadow);
        if (styleData.borderWidth) $('[data-prop="borderWidth"]').val(styleData.borderWidth);
        if (styleData.borderStyle) $('[data-prop="borderStyle"]').val(styleData.borderStyle);
        if (styleData.borderColor) $('[data-prop="borderColor"]').val(styleData.borderColor);
        if (styleData.padding) {
            $('[data-side="top"]').val(styleData.padding.top || '');
            $('[data-side="right"]').val(styleData.padding.right || '');
            $('[data-side="bottom"]').val(styleData.padding.bottom || '');
            $('[data-side="left"]').val(styleData.padding.left || '');
        }
        updateJson();
    }

    function updateJson() {
        var result = {};
        $('.sb-style-val').each(function() {
            var prop = $(this).data('prop');
            var val = $(this).val();
            if (val !== '' && val !== undefined) {
                if (prop === 'fontSize') {
                    result[prop] = { value: val, unit: 'px' };
                } else {
                    result[prop] = val;
                }
            }
        });
        // Padding
        var pad = {};
        $('.sb-style-pad').each(function() {
            var side = $(this).data('side');
            var val = $(this).val();
            if (val !== '') pad[side] = val;
        });
        if (Object.keys(pad).length > 0) result.padding = pad;
        $('#sb-style-json').val(JSON.stringify(result));
    }

    $(document).on('change input', '.sb-style-val, .sb-style-pad', function() { updateJson(); });
    setTimeout(loadExisting, 500);
});
</script>
