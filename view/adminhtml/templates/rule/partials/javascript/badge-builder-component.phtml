        saveRule() {
            // Validate required fields
            if (!this.rule.name || this.rule.name.trim() === '') {
                this.showError('Rule name is required');
                return;
            }

            // Show loading state
            this.showLoading('Saving badge rule...');

            const formData = new FormData();

            // Add form key (CSRF token)
            formData.append('form_key', '<?= $block->escapeJs($block->getFormKey()) ?>');

            // Add ajax flag
            formData.append('ajax', '1');

            // Add image file if selected
            if (this.imageFile) {
                formData.append('badge_image', this.imageFile);
            }

            // Add all rule data
            Object.keys(this.rule).forEach(key => {
                if (this.rule[key] !== null && this.rule[key] !== undefined) {
                    formData.append(key, this.rule[key]);
                }
            });

            // Add smart conditions as JSON
            formData.append('smart_conditions', JSON.stringify(this.smartConditions));

            // Add badge style settings as JSON
            formData.append('badge_style', JSON.stringify(this.badgeStyle));

            // Add image settings as JSON
            formData.append('image_settings', JSON.stringify(this.imageSettings));

            // Add schedule data
            if (this.schedule.enabled) {
                if (this.schedule.from) {
                    // Convert datetime-local to MySQL format
                    formData.append('schedule_from', this.schedule.from.replace('T', ' ') + ':00');
                }
                if (this.schedule.to) {
                    formData.append('schedule_to', this.schedule.to.replace('T', ' ') + ':00');
                }
            } else {
                // Clear schedule dates if disabled
                formData.append('schedule_from', '');
                formData.append('schedule_to', '');
            }

            fetch('<?= $block->escapeJs($block->getSaveUrl()) ?>', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('HTTP error! status: ' + response.status);
                }
                return response.json();
            })
            .then(data => {
                this.hideLoading();

                if (data.success) {
                    this.showSuccess(data.message || 'Badge rule saved successfully!');

                    // Redirect after a short delay
                    setTimeout(() => {
                        if (data.redirect_url) {
                            window.location.href = data.redirect_url;
                        } else {
                            this.goBack();
                        }
                    }, 1000);
                } else {
                    this.showError(data.message || 'Failed to save badge rule');
                }
            })
            .catch(error => {
                this.hideLoading();
                console.error('Error saving badge rule:', error);
                this.showError('An error occurred while saving the badge rule: ' + error.message);
            });
        },

