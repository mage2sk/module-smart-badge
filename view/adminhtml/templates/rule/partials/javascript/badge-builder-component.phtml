        },

        isProductSelected(productId) {
            return this.tempSelectedProducts.some(p => p.id === productId);
        },

        removeProduct(productId) {
            this.chosenProducts = this.chosenProducts.filter(p => p.id !== productId);
            this.rule.product_ids = this.chosenProducts.map(p => p.id).join(',');
        },

        // Category Chooser Methods
        openCategoryChooser() {
            this.showCategoryChooser = true;
            this.tempSelectedCategories = [...this.chosenCategories];
            this.categorySearchTerm = '';

            // Load category tree if not already loaded
            if (this.categoryTree.length === 0) {
                this.loadCategoryTree();
            }
        },

        async loadCategoryTree() {
            this.categoryTreeLoading = true;
            try {
                const formKey = document.querySelector('input[name="form_key"]')?.value;

                // Use URLSearchParams for proper form-encoded POST data
                const formData = new URLSearchParams();
                formData.append('form_key', formKey);

                const response = await fetch('<?= $block->escapeJs($block->getUrl('smartbadge/category/tree')) ?>', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData.toString()
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const data = await response.json();

                console.log('Category tree response:', data);

                if (data.success && data.categories) {
                    this.categoryTree = data.categories;
                    console.log('Category tree loaded:', this.categoryTree.length, 'root categories');
                } else {
                    const errorMsg = data.message || 'Unknown error occurred';
                    console.error('Failed to load categories:', errorMsg);
                    alert('Failed to load category tree: ' + errorMsg);
                }
            } catch (error) {
                console.error('Error loading category tree:', error);
                alert('Error loading categories: ' + error.message);
            } finally {
                this.categoryTreeLoading = false;
            }
        },

        closeCategoryChooser() {
            this.showCategoryChooser = false;
            this.categorySearchTerm = '';
        },

        confirmCategories() {
            this.chosenCategories = [...this.tempSelectedCategories];
            // Update rule.category_ids for backend
            this.rule.category_ids = this.chosenCategories.map(c => c.id).join(',');
            this.showCategoryChooser = false;
        },

        toggleCategoryExpand(categoryId) {
            this.categoryExpanded[categoryId] = !this.categoryExpanded[categoryId];
        },

        expandAllCategories() {
            const expandAll = (categories) => {
                categories.forEach(cat => {
                    this.categoryExpanded[cat.id] = true;
                    if (cat.children && cat.children.length > 0) {
                        expandAll(cat.children);
                    }
                });
            };
            expandAll(this.categoryTree);
        },

        collapseAllCategories() {
            this.categoryExpanded = {};
        },

        getCategoryPath(category, tree, currentPath = []) {
            for (let cat of tree) {
                if (cat.id === category.id) {
                    return [...currentPath, cat.name].join(' > ');
                }
                if (cat.children && cat.children.length > 0) {
                    const path = this.getCategoryPath(category, cat.children, [...currentPath, cat.name]);
                    if (path) return path;
                }
            }
            return null;
        },

        matchesSearch(category) {
            if (!this.categorySearchTerm) return true;
            const term = this.categorySearchTerm.toLowerCase();
            return category.name.toLowerCase().includes(term);
        },

        categoryOrChildrenMatch(category) {
            if (this.matchesSearch(category)) return true;
            if (category.children && category.children.length > 0) {
                return category.children.some(child => this.categoryOrChildrenMatch(child));
            }
            return false;
        },

        toggleCategorySelection(id, name, path) {
            const index = this.tempSelectedCategories.findIndex(c => c.id === id);
            if (index > -1) {
                this.tempSelectedCategories.splice(index, 1);
            } else {
                this.tempSelectedCategories.push({ id, name, path });
            }
        },

        isCategorySelected(categoryId) {
            return this.tempSelectedCategories.some(c => c.id === categoryId);
        },

        removeCategory(categoryId) {
            this.chosenCategories = this.chosenCategories.filter(c => c.id !== categoryId);
            this.rule.category_ids = this.chosenCategories.map(c => c.id).join(',');
        },

        // Load existing products when editing a rule
        async loadExistingProducts(productIds) {
            if (!productIds || productIds.trim() === '') {
                console.log('No product IDs to load');
                return;
            }

            console.log('Loading existing products:', productIds);

            try {
                const response = await fetch('<?= $block->escapeJs($block->getUrl('smartbadge/product/getbyids')) ?>', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: new URLSearchParams({
                        'form_key': '<?= $block->escapeJs($block->getFormKey()) ?>',
                        'ids': productIds
                    })
                });

                if (!response.ok) {
                    throw new Error('Failed to fetch products');
                }

                const data = await response.json();

                if (data.success && data.products) {
                    this.chosenProducts = data.products;
                    console.log('Loaded products:', this.chosenProducts);
                } else {
                    console.error('Failed to load products:', data.message || 'Unknown error');
                }
            } catch (error) {
                console.error('Error loading existing products:', error);
            }
        },

        // Load existing categories when editing a rule
        async loadExistingCategories(categoryIds) {
            if (!categoryIds || categoryIds.trim() === '') {
                console.log('No category IDs to load');
                return;
            }

            console.log('Loading existing categories:', categoryIds);

            try {
                const response = await fetch('<?= $block->escapeJs($block->getUrl('smartbadge/category/getbyids')) ?>', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: new URLSearchParams({
                        'form_key': '<?= $block->escapeJs($block->getFormKey()) ?>',
                        'ids': categoryIds
                    })
                });

                if (!response.ok) {
                    throw new Error('Failed to fetch categories');
                }

                const data = await response.json();

                if (data.success && data.categories) {
                    this.chosenCategories = data.categories;
                    console.log('Loaded categories:', this.chosenCategories);
                } else {
                    console.error('Failed to load categories:', data.message || 'Unknown error');
                }
            } catch (error) {
                console.error('Error loading existing categories:', error);
            }
        }
    };

    // Merge existing data for smart_conditions, badge_style, image_settings, and schedule
    if (existingRule) {
        // Merge smart_conditions if exists
        if (existingRule.smart_conditions) {
            componentData.smartConditions = { ...componentData.smartConditions, ...existingRule.smart_conditions };
        }

        // Merge badge_style if exists
        if (existingRule.badge_style) {
            componentData.badgeStyle = { ...componentData.badgeStyle, ...existingRule.badge_style };
        }

        // Merge image_settings if exists
        if (existingRule.image_settings) {
            componentData.imageSettings = { ...componentData.imageSettings, ...existingRule.image_settings };
        }

        // Merge schedule if exists
        if (existingRule.schedule_from || existingRule.schedule_to) {
            componentData.schedule = {
                enabled: !!(existingRule.schedule_from || existingRule.schedule_to),
                from: existingRule.schedule_from || '',
                to: existingRule.schedule_to || ''
            };
        }

        // Load existing products and categories asynchronously
        // This will be called during component initialization via x-init
        if (existingRule.product_ids) {
            console.log('Will load existing products:', existingRule.product_ids);
            // Store the IDs for loading after component mount
            componentData._pendingProductIds = existingRule.product_ids;
        }

        if (existingRule.category_ids) {
            console.log('Will load existing categories:', existingRule.category_ids);
            // Store the IDs for loading after component mount
            componentData._pendingCategoryIds = existingRule.category_ids;
        }
    }

    console.log('✅ badgeBuilder returning component data');
    console.log('✅ Has openProductChooser?', typeof componentData.openProductChooser);
    console.log('✅ Has openCategoryChooser?', typeof componentData.openCategoryChooser);
    return componentData;

    } catch (error) {
        console.error('❌ Error in badgeBuilder initialization:', error);
        return {
            error: true,
            errorMessage: error.message,
            showProductChooser: false,
            showCategoryChooser: false
        };
    }
};

// Add error handling wrapper
// Debug Alpine initialization
window.addEventListener('alpine:init', () => {
    console.log('🟢 Alpine initializing...');
});

document.addEventListener('alpine:initialized', () => {
    console.log('🟢 Alpine fully initialized');
});

// Catch Alpine errors
window.addEventListener('error', (e) => {
    if (e.message && e.message.includes('Alpine')) {
        console.error('❌ ALPINE ERROR:', e.message, e);
    }
});

document.addEventListener('alpine:init', () => {
    console.log('Alpine.js initialized');
});
</script>
