        getFilteredIcons() {
            if (!this.fontAwesomeIcons || !Array.isArray(this.fontAwesomeIcons)) {
                console.warn('⚠️ fontAwesomeIcons not available');
                return [];
            }

            let icons = this.fontAwesomeIcons;

            // Filter by category
            if (this.iconCategory !== 'all') {
                icons = icons.filter(icon => icon && icon.category === this.iconCategory);
            }

            // Filter by search
            if (this.iconSearch && this.iconSearch.trim() !== '') {
                const search = this.iconSearch.toLowerCase();
                icons = icons.filter(icon =>
                    icon && icon.name && icon.class &&
                    (icon.name.toLowerCase().includes(search) ||
                    icon.class.toLowerCase().includes(search))
                );
            }

            // Ensure all items have required properties
            icons = icons.filter(icon => icon && icon.class);

            // Limit to 100 icons for performance (especially for 'all' category)
            return icons.slice(0, 100);
