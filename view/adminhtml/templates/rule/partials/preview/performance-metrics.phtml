<!-- Performance Metrics -->
<div class="performance-metrics">
    <h4>📈 Estimated Performance</h4>
    <div class="metrics-grid">
        <div class="metric-card">
            <span class="metric-icon">👁️</span>
            <div class="metric-value" x-text="calculateVisibility()"></div>
            <div class="metric-label">Visibility</div>
        </div>
        <div class="metric-card">
            <span class="metric-icon">🎯</span>
            <div class="metric-value" x-text="calculateUrgency()"></div>
            <div class="metric-label">Urgency</div>
        </div>
        <div class="metric-card">
            <span class="metric-icon">💰</span>
            <div class="metric-value">+---%</div>
            <div class="metric-label">Est. Conversion</div>
        </div>
    </div>
</div>
