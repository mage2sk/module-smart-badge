<!-- Product Detail View Preview -->
<div x-show="previewMode === 'product'" class="product-preview-mockup">
    <div class="product-card">
        <div class="mock-product-image">
            <div class="badge-live-preview"
                 :style="getBadgeStyle()"
                 :class="[rule.animation, 'badge-position-' + (rule.use_same_position ? (rule.position_all || 'top-left') : (previewMode === 'product' ? (rule.position_product || 'top-left') : (rule.position_category || 'top-left')))]">
                <!-- Show image if uploaded -->
                <template x-if="imagePreview">
                    <img :src="imagePreview" alt="Badge" class="badge-image-preview" :style="getImageStyle()">
                </template>
                <!-- Show icon if no image -->
                <template x-if="!imagePreview">
                    <span>
                        <template x-if="iconType === 'fontawesome' && rule.badge_icon.startsWith('fa-')">
                            <i :class="rule.badge_icon"></i>
                        </template>
                        <template x-if="iconType === 'emoji' || !rule.badge_icon.startsWith('fa-')">
                            <span x-text="rule.badge_icon || '🔥'"></span>
                        </template>
                    </span>
                </template>
                <!-- Show text only if imageOnly is false -->
                <span x-show="!imageSettings.imageOnly" x-text="rule.badge_text || getBadgeLabel()"></span>
            </div>
            <div class="mock-image-placeholder">
                <svg width="100%" height="100%" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="productGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color:#667eea;stop-opacity:0.8"></stop>
                            <stop offset="100%" style="stop-color:#764ba2;stop-opacity:0.8"></stop>
                        </linearGradient>
                    </defs>
                    <rect width="400" height="400" fill="url(#productGradient)"></rect>
                    <circle cx="200" cy="180" r="60" fill="white" opacity="0.2"></circle>
                    <rect x="140" y="200" width="120" height="100" rx="10" fill="white" opacity="0.2"></rect>
                    <text x="200" y="330" font-family="Arial, sans-serif" font-size="24" fill="white" text-anchor="middle" opacity="0.7">Premium Product</text>
                </svg>
            </div>
        </div>
        <div class="mock-product-info">
            <div class="product-category">Electronics</div>
            <h4 class="product-title">Premium Wireless Headphones</h4>

            <!-- Star Rating -->
            <div class="product-rating">
                <div class="stars">
                    <span class="star filled">★</span>
                    <span class="star filled">★</span>
                    <span class="star filled">★</span>
                    <span class="star filled">★</span>
                    <span class="star half">★</span>
                </div>
                <span class="rating-text">(4.5) 1,234 reviews</span>
            </div>

            <!-- Price -->
            <div class="mock-price">
                <span class="old-price">$199.99</span>
                <span class="new-price">$149.99</span>
                <span class="discount-badge">25% OFF</span>
            </div>

            <!-- Stock Status -->
            <div class="stock-status in-stock">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <circle cx="8" cy="8" r="8" fill="#10b981"></circle>
                    <path d="M5 8l2 2 4-4" stroke="white" stroke-width="2" stroke-linecap="round"></path>
                </svg>
                <span>In Stock - Ships Today</span>
            </div>

            <!-- Product Description -->
            <p class="mock-description">
                Experience premium sound quality with active noise cancellation,
                30-hour battery life, and premium comfort. Perfect for music lovers
                and professionals.
            </p>

            <!-- Features List -->
            <ul class="product-features">
                <li>
                    <svg width="16" height="16" viewBox="0 0 16 16">
                        <path d="M13 4L6 11 3 8" stroke="#10b981" stroke-width="2" fill="none" stroke-linecap="round"></path>
                    </svg>
                    Active Noise Cancellation
                </li>
                <li>
                    <svg width="16" height="16" viewBox="0 0 16 16">
                        <path d="M13 4L6 11 3 8" stroke="#10b981" stroke-width="2" fill="none" stroke-linecap="round"></path>
                    </svg>
                    30-Hour Battery Life
                </li>
                <li>
                    <svg width="16" height="16" viewBox="0 0 16 16">
                        <path d="M13 4L6 11 3 8" stroke="#10b981" stroke-width="2" fill="none" stroke-linecap="round"></path>
                    </svg>
                    Premium Sound Quality
                </li>
            </ul>

            <!-- Quantity & Add to Cart - Disabled for Preview -->
            <div class="product-actions preview-disabled">
                <div class="quantity-selector">
                    <button class="qty-btn" disabled style="pointer-events: none; opacity: 0.6; cursor: not-allowed;">−</button>
                    <input type="number" value="1" min="1" class="qty-input" readonly style="pointer-events: none; opacity: 0.6;">
                    <button class="qty-btn" disabled style="pointer-events: none; opacity: 0.6; cursor: not-allowed;">+</button>
                </div>
                <button class="add-to-cart-btn" disabled style="pointer-events: none; opacity: 0.6; cursor: not-allowed;">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M6 6V5a3 3 0 016 0v1M3 6h14l-1 9H4L3 6z" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                    </svg>
                    Add to Cart
                </button>
            </div>

            <!-- Additional Actions - Disabled for Preview -->
            <div class="product-extra-actions preview-disabled">
                <button class="action-btn wishlist" disabled style="pointer-events: none; opacity: 0.6; cursor: not-allowed;">
                    <svg width="18" height="18" viewBox="0 0 18 18">
                        <path d="M9 15.5s-6-4-6-8a3 3 0 016-1.5 3 3 0 016 1.5c0 4-6 8-6 8z" stroke="currentColor" stroke-width="1.5" fill="none"></path>
                    </svg>
                    Add to Wishlist
                </button>
                <button class="action-btn compare" disabled style="pointer-events: none; opacity: 0.6; cursor: not-allowed;">
                    <svg width="18" height="18" viewBox="0 0 18 18">
                        <path d="M3 6h12M3 12h12M7 3v12M11 3v12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                    </svg>
                    Compare
                </button>
            </div>
        </div>
    </div>
</div>
