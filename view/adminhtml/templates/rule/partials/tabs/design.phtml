                            <button type="button" @click="rule.badge_icon = '🏅'" class="icon-btn" title="Medal">🏅</button>
                            <!-- Hearts & Love -->
                            <button type="button" @click="rule.badge_icon = '❤️'" class="icon-btn" title="Red Heart">❤️</button>
