                            <button type="button" @click="rule.badge_icon = '🔥'" class="icon-btn" title="Fire">🔥</button>
                            <button type="button" @click="rule.badge_icon = '⚡'" class="icon-btn" title="Lightning">⚡</button>
                            <button type="button" @click="rule.badge_icon = '💥'" class="icon-btn" title="Boom">💥</button>
                            <button type="button" @click="rule.badge_icon = '✨'" class="icon-btn" title="Sparkles">✨</button>
