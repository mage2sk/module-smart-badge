                        <div x-show="iconType === 'fontawesome' && rule.badge_icon.startsWith('fa-')" class="selected-icon-preview">
                            <label>Selected Icon:</label>
                            <div class="icon-preview-box">
                                <i :class="rule.badge_icon" style="font-size: 32px;"></i>
                                <span x-text="rule.badge_icon"></span>
                            </div>
                        </div>
                    </div>
                </div>
