                            <button type="button" @click="rule.badge_icon = '🏆'" class="icon-btn" title="Trophy">🏆</button>
                            <button type="button" @click="rule.badge_icon = '🥇'" class="icon-btn" title="Gold Medal">🥇</button>
                            <button type="button" @click="rule.badge_icon = '🥈'" class="icon-btn" title="Silver Medal">🥈</button>
                            <button type="button" @click="rule.badge_icon = '🥉'" class="icon-btn" title="Bronze Medal">🥉</button>
