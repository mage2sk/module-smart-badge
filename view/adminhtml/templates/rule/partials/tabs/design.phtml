                <div x-show="activeTab === 'design'" class="tab-pane">
                    <div class="form-group">
                        <label>Custom Color</label>
                        <div class="color-picker-group">
                            <input type="color" x-model="rule.badge_color" class="color-input">
                            <input type="text" x-model="rule.badge_color" placeholder="#FF0000" class="form-control">
                            <button type="button" @click="generateAiColors()" class="btn-ai-color">
                                <span class="icon">🎨</span> AI Generate
                            </button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Suggested Color Palettes</label>
                        <div class="color-palette-grid">
                            <div class="palette-card" @click="rule.badge_color = '#6366f1'">
                                <div class="palette-preview" style="background: linear-gradient(135deg, #6366f1, #4f46e5)"></div>
                                <span>Red Hot</span>
                            </div>
                            <div class="palette-card" @click="rule.badge_color = '#10b981'">
                                <div class="palette-preview" style="background: linear-gradient(135deg, #10b981, #059669)"></div>
                                <span>Fresh Green</span>
                            </div>
                            <div class="palette-card" @click="rule.badge_color = '#8b5cf6'">
                                <div class="palette-preview" style="background: linear-gradient(135deg, #8b5cf6, #7c3aed)"></div>
                                <span>Royal Purple</span>
                            </div>
                            <div class="palette-card" @click="rule.badge_color = '#f59e0b'">
                                <div class="palette-preview" style="background: linear-gradient(135deg, #f59e0b, #d97706)"></div>
                                <span>Golden Hour</span>
                            </div>
                        </div>
                    </div>

