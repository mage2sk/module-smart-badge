<script>
require(['jquery', 'domReady!'], function($) {
    var scData = {};

    // Load existing data from hidden field
    function loadExisting() {
        var existing = $('[name="smart_conditions"]').not('#sb-sc-json').val();
        if (existing && typeof existing === 'string') {
            try { scData = JSON.parse(existing); } catch(e) { scData = {}; }
        }
        // Populate UI from data
        Object.keys(scData).forEach(function(key) {
            var cond = scData[key];
            if (cond && cond.enabled) {
                var cb = $('.sb-sc-toggle[data-key="' + key + '"]');
                cb.prop('checked', true);
                $('.sb-sc-fields[data-for="' + key + '"]').show();
                Object.keys(cond).forEach(function(prop) {
                    if (prop !== 'enabled') {
                        $('.sb-sc-val[data-key="' + key + '"][data-prop="' + prop + '"]').val(cond[prop]);
                    }
                });
            }
        });
        updateJson();
    }

    function updateJson() {
        var result = {};
        $('.sb-sc-toggle').each(function() {
            var key = $(this).data('key');
            var enabled = $(this).is(':checked');
            result[key] = { enabled: enabled };
            $('.sb-sc-val[data-key="' + key + '"]').each(function() {
                result[key][$(this).data('prop')] = $(this).val();
            });
        });
        $('#sb-sc-json').val(JSON.stringify(result));
    }

    // Toggle visibility
    $(document).on('change', '.sb-sc-toggle', function() {
        var key = $(this).data('key');
        $('.sb-sc-fields[data-for="' + key + '"]').toggle($(this).is(':checked'));
        updateJson();
    });

    // Update JSON on value change
    $(document).on('change input', '.sb-sc-val', function() { updateJson(); });

    setTimeout(loadExisting, 500);
});
</script>
