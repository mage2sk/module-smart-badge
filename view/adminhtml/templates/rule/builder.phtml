<script>
// Magento delete confirmation
function deleteConfirm(message, url) {
    if (confirm(message)) {
        window.location.href = url;
    }
}

// Save and Continue Edit
function saveContinue() {
    var form = document.getElementById('badge-rule-form');
    var input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'back';
    input.value = 'edit';
    form.appendChild(input);
    form.submit();
}

// Initialize Magento Date Pickers
require([
    'jquery',
    'mage/calendar'
], function($) {
    'use strict';

    $(document).ready(function() {
        // Common calendar options for proper positioning
        var commonOptions = {
            showButtonPanel: true,
            beforeShow: function(input, inst) {
                // Ensure proper positioning relative to input field
                setTimeout(function() {
                    var $input = $(input);
                    var offset = $input.offset();
                    var height = $input.outerHeight();

                    $('#ui-datepicker-div').css({
                        'top': (offset.top + height + 5) + 'px',
                        'left': offset.left + 'px',
                        'position': 'absolute',
                        'z-index': 10000
                    });
                }, 0);
            }
        };

        // Schedule date pickers (with time)
        $('#schedule_from').calendar($.extend({}, commonOptions, {
            dateFormat: 'yy-mm-dd',
            showsTime: true,
            timeFormat: 'HH:mm:ss',
            buttonText: 'Select Date and Time'
        }));

        $('#schedule_to').calendar($.extend({}, commonOptions, {
            dateFormat: 'yy-mm-dd',
            showsTime: true,
            timeFormat: 'HH:mm:ss',
            buttonText: 'Select Date and Time'
        }));

        // Smart condition date pickers (date only)
        $('#smart_condition_date_from').calendar($.extend({}, commonOptions, {
            dateFormat: 'yy-mm-dd',
            buttonText: 'Select Date',
            onSelect: function(dateText) {
                // Update Alpine.js data when calendar changes
                const alpineComponent = document.querySelector('[x-data]').__x;
                if (alpineComponent && alpineComponent.$data.smartConditions) {
                    alpineComponent.$data.smartConditions.dateRange.from = dateText;
                }
            }
        }));

        $('#smart_condition_date_to').calendar($.extend({}, commonOptions, {
            dateFormat: 'yy-mm-dd',
            buttonText: 'Select Date',
            onSelect: function(dateText) {
                // Update Alpine.js data when calendar changes
                const alpineComponent = document.querySelector('[x-data]').__x;
                if (alpineComponent && alpineComponent.$data.smartConditions) {
                    alpineComponent.$data.smartConditions.dateRange.to = dateText;
                }
            }
        }));
    });
});
</script>
