<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">smartbadge_rule_listing.smartbadge_rule_listing_data_source</item>
        </item>
    </argument>

    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Create New Badge Rule</label>
            </button>
        </buttons>
        <spinner>smartbadge_rule_columns</spinner>
        <deps>
            <dep>smartbadge_rule_listing.smartbadge_rule_listing_data_source</dep>
        </deps>
    </settings>

    <dataSource name="smartbadge_rule_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">rule_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Panth_SmartBadge::rule</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="smartbadge_rule_listing_data_source">
            <settings>
                <requestFieldName>rule_id</requestFieldName>
                <primaryFieldName>rule_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters">
            <settings>
                <templates>
                    <filters>
                        <select>
                            <param name="template" xsi:type="string">ui/grid/filters/elements/ui-select</param>
                            <param name="component" xsi:type="string">Magento_Ui/js/form/element/ui-select</param>
                        </select>
                    </filters>
                </templates>
            </settings>
        </filters>
        <massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to delete selected rules?</message>
                        <title translate="true">Delete Rules</title>
                    </confirm>
                    <url path="smartbadge/rule/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
            <action name="status">
                <settings>
                    <type>status</type>
                    <label translate="true">Change Status</label>
                    <actions>
                        <action name="0">
                            <type>enable</type>
                            <label translate="true">Enable</label>
                            <url path="smartbadge/rule/massStatus">
                                <param name="status">1</param>
                            </url>
                        </action>
                        <action name="1">
                            <type>disable</type>
                            <label translate="true">Disable</label>
                            <url path="smartbadge/rule/massStatus">
                                <param name="status">0</param>
                            </url>
                        </action>
                    </actions>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>

    <columns name="smartbadge_rule_columns">
        <settings>
            <editorConfig>
                <param name="clientConfig" xsi:type="array">
                    <item name="saveUrl" xsi:type="url" path="smartbadge/rule/inlineEdit"/>
                    <item name="validateBeforeSave" xsi:type="boolean">false</item>
                </param>
                <param name="indexField" xsi:type="string">rule_id</param>
                <param name="enabled" xsi:type="boolean">true</param>
                <param name="selectProvider" xsi:type="string">smartbadge_rule_listing.smartbadge_rule_listing.smartbadge_rule_columns.ids</param>
            </editorConfig>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">smartbadge_rule_listing.smartbadge_rule_listing.smartbadge_rule_columns_editor</item>
                    <item name="target" xsi:type="string">startEdit</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">${ $.$data.rowIndex }</item>
                        <item name="1" xsi:type="boolean">true</item>
                    </item>
                </param>
            </childDefaults>
        </settings>

        <selectionsColumn name="ids">
            <settings>
                <indexField>rule_id</indexField>
                <resizeEnabled>false</resizeEnabled>
                <resizeDefaultWidth>55</resizeDefaultWidth>
            </settings>
        </selectionsColumn>

        <column name="rule_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
                <resizeDefaultWidth>55</resizeDefaultWidth>
            </settings>
        </column>

        <column name="is_active" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <editor>
                    <editorType>select</editorType>
                </editor>
                <dataType>select</dataType>
                <label translate="true">Status</label>
                <resizeDefaultWidth>75</resizeDefaultWidth>
            </settings>
        </column>

        <column name="priority">
            <settings>
                <filter>textRange</filter>
                <editor>
                    <validation>
                        <rule name="validate-number" xsi:type="boolean">true</rule>
                    </validation>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">Priority</label>
                <resizeDefaultWidth>75</resizeDefaultWidth>
            </settings>
        </column>

        <column name="name">
            <settings>
                <filter>text</filter>
                <editor>
                    <editorType>text</editorType>
                    <validation>
                        <rule name="required-entry" xsi:type="boolean">true</rule>
                    </validation>
                </editor>
                <label translate="true">Rule Name</label>
                <resizeDefaultWidth>200</resizeDefaultWidth>
            </settings>
        </column>

        <column name="badge_type">
            <settings>
                <filter>text</filter>
                <label translate="true">Badge Type</label>
                <resizeDefaultWidth>120</resizeDefaultWidth>
            </settings>
        </column>

        <column name="badge_text">
            <settings>
                <filter>text</filter>
                <editor>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">Custom Text</label>
                <resizeDefaultWidth>120</resizeDefaultWidth>
            </settings>
        </column>

        <column name="badge_color">
            <settings>
                <filter>text</filter>
                <editor>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">Custom Color</label>
                <resizeDefaultWidth>100</resizeDefaultWidth>
            </settings>
        </column>

        <column name="product_ids">
            <settings>
                <label translate="true">Product IDs</label>
                <resizeDefaultWidth>120</resizeDefaultWidth>
                <visible>false</visible>
            </settings>
        </column>

        <column name="category_ids">
            <settings>
                <label translate="true">Category IDs</label>
                <resizeDefaultWidth>120</resizeDefaultWidth>
                <visible>false</visible>
            </settings>
        </column>

        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created</label>
                <resizeDefaultWidth>150</resizeDefaultWidth>
            </settings>
        </column>

        <actionsColumn name="actions" class="Magento\Backend\Ui\Component\Listing\Column\EditAction">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="editUrlPath" xsi:type="string">smartbadge/rule/edit</item>
                    <item name="urlEntityParamName" xsi:type="string">rule_id</item>
                </item>
            </argument>
            <settings>
                <indexField>rule_id</indexField>
                <resizeDefaultWidth>75</resizeDefaultWidth>
            </settings>
        </actionsColumn>
    </columns>
</listing>
